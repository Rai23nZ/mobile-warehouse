# ═══════════════════════════════════════════════════════════════════════
# Caddy — единственное, что смотрит в интернет.
#
# Он сам получает сертификат Let's Encrypt и сам его продлевает: ручной
# настройки TLS не требуется. Приложение слушает только 127.0.0.1 и
# снаружи недоступно.
#
# Файл кладётся в /etc/caddy/Caddyfile
# Домен заменить на свой.
# ═══════════════════════════════════════════════════════════════════════

ru.warehouse-sync.ru {
	# Приложение на localhost
	reverse_proxy 127.0.0.1:8787

	# Логи в journald вместе с остальными
	log {
		output stderr
		format console
		level INFO
	}

	# Заголовки безопасности. CORS выставляет само приложение —
	# здесь его не трогаем, иначе получатся дубли и браузер отвергнет ответ.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Тело запроса: пул товаров уходит кусками до 900 КБ,
	# с запасом ставим 5 МБ
	request_body {
		max_size 5MB
	}
}
